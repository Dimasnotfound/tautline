{
  "manifest_version": 3,
  "name": "Tautline Relay Bridge",
  "version": "2.10.0",
  "description": "Delivers Tautline relay worker prompts to fresh ChatGPT tabs in Laju Browser.",
  "key": "",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
