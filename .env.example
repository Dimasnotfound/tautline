# Tautline v2.1.0 configuration
# Copy this file to .env and replace example values before use.

# Comma-separated directories Tautline may access.
TAUTLINE_ALLOWED_ROOTS=.

# Use a unique random 64-character value.
TAUTLINE_OWNER_TOKEN=replace-with-a-random-64-character-secret
TAUTLINE_REQUIRE_AUTH=true

# Local service and runtime.
TAUTLINE_PORT=7688
TAUTLINE_RUNTIME_DIR=runtime/v2
TAUTLINE_OPEN_DASHBOARD=true
# TAUTLINE_CONFIG=runtime/v2/config/tautline.json

# MCP Apps widget mode: changes, full, or off.
TAUTLINE_WIDGETS=changes

# Public HTTPS origin. Leave empty for local-only use.
TAUTLINE_PUBLIC_BASE_URL=
TAUTLINE_WIDGET_DOMAIN=

# 9Router sub-agent endpoint and strict model access.
TAUTLINE_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
TAUTLINE_9ROUTER_API_KEY=
TAUTLINE_9ROUTER_MODEL=auto
TAUTLINE_9ROUTER_ALLOWED_MODELS=auto

# Global and per-slot sub-agent defaults.
TAUTLINE_AGENT_ENABLED=true
TAUTLINE_AGENT_CAPACITY=2
TAUTLINE_AGENT_TIMEOUT_SECONDS=900
TAUTLINE_AGENT_IMAGE_SUPPORT=false
TAUTLINE_AGENT_RTK=false
TAUTLINE_AGENT_CAVEMAN=false

# Lightpanda browser runtime.
TAUTLINE_LIGHTPANDA_PATH=auto
TAUTLINE_LIGHTPANDA_DOCKER_IMAGE=lightpanda/browser:nightly
TAUTLINE_LIGHTPANDA_PORT=9223
TAUTLINE_LIGHTPANDA_AUTOSTART=false
TAUTLINE_LIGHTPANDA_OBEY_ROBOTS=true

# Cloudflare Tunnel. Mode: off, quick, or named.
TAUTLINE_CLOUDFLARED_PATH=bin/cloudflared
TAUTLINE_TUNNEL_MODE=off
TAUTLINE_TUNNEL_NAME=
TAUTLINE_CUSTOM_DOMAIN=
TAUTLINE_TUNNEL_PROTOCOL=http2
TAUTLINE_TUNNEL_AUTOSTART=false

# Optional shell override for bounded commands.
# TAUTLINE_SHELL=C:\Program Files\Git\bin\bash.exe
