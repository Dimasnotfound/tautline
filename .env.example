# Tautline v2.10.0 configuration
# Copy to .env and replace example values. Never commit the resulting .env file.

# Comma-separated directories Tautline may access.
TAUTLINE_ALLOWED_ROOTS=D:\Projects

# Generate a unique random 64-character value.
TAUTLINE_OWNER_TOKEN=replace-with-a-random-64-character-secret
TAUTLINE_REQUIRE_AUTH=true

# Local service and runtime.
TAUTLINE_PORT=7688
TAUTLINE_RUNTIME_DIR=runtime/v2
# Defaults to <runtime>/worktrees when omitted.
TAUTLINE_WORKTREE_ROOT=runtime/v2/worktrees
TAUTLINE_OPEN_DASHBOARD=true
# TAUTLINE_CONFIG=runtime/v2/config/tautline.json

# One live activity widget. Values: on or off.
# Legacy values changes and full are accepted as aliases for on.
TAUTLINE_WIDGETS=on

# Merge Codex model_instructions_file and global AGENTS guidance into the primary ChatGPT MCP instructions.
TAUTLINE_CODEX_INSTRUCTIONS=on

# Public HTTPS origin. Leave empty for local-only use.
TAUTLINE_PUBLIC_BASE_URL=
TAUTLINE_WIDGET_DOMAIN=

# Native Google Docs OAuth client. Use a Google Cloud Desktop or Web OAuth client
# whose loopback redirect matches the google_docs config in runtime/v2/config/tautline.json.
GOOGLE_DOCS_OAUTH_CLIENT_ID=
GOOGLE_DOCS_OAUTH_CLIENT_SECRET=

# Optional legacy 9Router backend. These values are unused by chatgpt-relay.
TAUTLINE_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
TAUTLINE_9ROUTER_API_KEY=
TAUTLINE_9ROUTER_MODEL=auto
TAUTLINE_9ROUTER_ALLOWED_MODELS=auto

# Global and per-slot sub-agent defaults.
# chatgpt-relay uses ordinary ChatGPT conversations with one manual New Chat + paste step.
TAUTLINE_AGENT_ENABLED=true
TAUTLINE_AGENT_BACKEND=chatgpt-relay
TAUTLINE_AGENT_CAPACITY=2
TAUTLINE_AGENT_TIMEOUT_SECONDS=900
TAUTLINE_AGENT_IMAGE_SUPPORT=false
TAUTLINE_AGENT_RTK=false
TAUTLINE_AGENT_CAVEMAN=false

# Lightpanda browser runtime.
TAUTLINE_LIGHTPANDA_PATH=auto
TAUTLINE_LIGHTPANDA_DOCKER_IMAGE=lightpanda/browser:nightly
TAUTLINE_LIGHTPANDA_PORT=9223
TAUTLINE_LIGHTPANDA_AUTOSTART=false
TAUTLINE_LIGHTPANDA_OBEY_ROBOTS=true
TAUTLINE_LIGHTPANDA_NATIVE_MCP=true
TAUTLINE_LIGHTPANDA_PERSIST_SESSION=true
TAUTLINE_LIGHTPANDA_BLOCK_PRIVATE_NETWORKS=true
TAUTLINE_LIGHTPANDA_NATIVE_TIMEOUT_SECONDS=30
# TAUTLINE_LIGHTPANDA_WSL_DISTRO=TautlineLightpanda
# TAUTLINE_LIGHTPANDA_WSL_PATH=/root/.local/bin/lightpanda

# Cloudflare Tunnel. Mode: off, quick, or named.
TAUTLINE_CLOUDFLARED_PATH=bin/cloudflared.exe
TAUTLINE_TUNNEL_MODE=off
TAUTLINE_TUNNEL_NAME=
TAUTLINE_CUSTOM_DOMAIN=
TAUTLINE_TUNNEL_PROTOCOL=http2
TAUTLINE_TUNNEL_AUTOSTART=false

# Optional shell override for bounded commands.
# DEVSPACE_SHELL=C:\Program Files\Git\bin\bash.exe

# Optional Hermes skill bridge overrides retained for compatibility.
# DEVSPACE_HERMES_HOME=%LOCALAPPDATA%\hermes
# DEVSPACE_HERMES_AGENT_DIR=%LOCALAPPDATA%\hermes\hermes-agent
# DEVSPACE_HERMES_PYTHON=python
