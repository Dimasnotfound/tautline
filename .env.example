# Copy this file to .env and replace every example value.
# Never commit your real .env file.

# Comma-separated directories DevSpace may access.
# Windows example: D:\Projects,D:\Work\my-app
# macOS/Linux example: /Users/you/Projects,/home/you/work
DEVSPACE_ALLOWED_ROOTS=.

# Generate a long random secret. This signs OAuth access and refresh tokens.
DEVSPACE_OWNER_TOKEN=replace-with-a-random-64-character-secret

# Keep authentication enabled for every public or tunneled deployment.
DEVSPACE_REQUIRE_AUTH=true

# UI mode: changes (recommended), full, or off.
# changes = one workspace card and one aggregate review card per editing turn.
DEVSPACE_WIDGETS=changes

# Show an already configured token in the terminal only when you explicitly need it.
DEVSPACE_SHOW_OWNER_TOKEN=false

# Public HTTPS origin used by ChatGPT, without a trailing slash.
DEVSPACE_PUBLIC_BASE_URL=https://mcp.example.com

# Optional Cloudflare named tunnel integration.
DEVSPACE_START_TUNNEL=false
DEVSPACE_TUNNEL_NAME=your-tunnel-name
DEVSPACE_TUNNEL_PROTOCOL=http2
# DEVSPACE_CLOUDFLARED_PATH=C:\Tools\cloudflared.exe

# Optional shell override. Windows users normally get Git Bash when installed,
# otherwise cmd.exe. macOS/Linux default to sh.
# DEVSPACE_SHELL=C:\Program Files\Git\bin\bash.exe

# Optional runtime directory for PID files.
DEVSPACE_RUNTIME_DIR=runtime
